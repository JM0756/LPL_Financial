  border-radius: 9px;
  background: #fff5f3;
  color: #753730;
  font-size: 0.82rem;
  line-height: 1.5;
}

.auth-info {
  margin-bottom: 14px;
  padding: 12px 14px;
  border: 1px solid #a9cbc5;
  border-radius: 9px;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
  font-size: 0.82rem;
  line-height: 1.5;
}

.auth-advisor-note {
  margin: 4px 0 0;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.5;
  text-align: center;
  font-style: italic;
}

/* Auth session banner in header */
.auth-session-banner {
  display: flex;
  align-items: center;
  gap: 10px;
}

.auth-user-badge {
  border: 1px solid var(--color-border-strong);
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 0.74rem;
  font-weight: 700;
  color: var(--color-navy);
  background: var(--color-surface);
  white-space: nowrap;
  max-width: 160px;
  overflow: hidden;
  text-overflow: ellipsis;
}

.auth-role-badge-advisor {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
}

.auth-signout-btn {
  font-size: 0.76rem;
  color: var(--color-muted) !important;
}

@media (max-width: 480px) {
  .auth-card {
    padding: 28px 22px;
  }
}
