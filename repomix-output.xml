  color: var(--color-muted);
  font-size: 0.79rem;
  line-height: 1.5;
}

.scenario-horizon {
  margin-top: 9px;
  color: var(--color-teal-dark);
  font-size: 0.72rem;
  font-weight: 800;
}

.confirmation-card {
  margin-top: 20px;
  padding: 22px;
  border: 1px solid #cbd8d5;
  border-radius: 14px;
  background: #f7faf8;
}

.confirmation-heading h3 {
  font-size: 1.15rem;
}

.text-button {
  border: 0;
  background: transparent;
  color: var(--color-teal-dark);
  padding: 5px;
  font-size: 0.79rem;
  font-weight: 800;
  cursor: pointer;
}

.text-button:hover {
  text-decoration: underline;
}

.confirmed-scenario {
  margin-top: 19px;
  padding-bottom: 15px;
  border-bottom: 1px solid #dbe4e1;
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.confirmed-scenario strong {
  font-size: 0.9rem;
}

.confirmed-scenario span {
  color: var(--color-muted);
  font-size: 0.79rem;
  white-space: nowrap;
}

.context-note {
  margin: 15px 0 0;
  border-left: 3px solid var(--color-teal);
  padding: 9px 12px;
  background: var(--color-teal-soft);
  color: var(--color-navy);
  font-size: 0.8rem;
  line-height: 1.5;
}

.assumption-list {
  margin: 16px 0 20px;
  padding-left: 20px;
  color: var(--color-muted);
  columns: 2;
  column-gap: 28px;
  font-size: 0.79rem;
  line-height: 1.7;
}

.assumption-list li::marker {
  color: var(--color-teal);
}

.empty-confirmation {
  min-height: 76px;
  margin-top: 20px;
  border: 1px dashed var(--color-border-strong);
  border-radius: 12px;
  color: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 16px;
  font-size: 0.8rem;
  text-align: center;
}

.empty-confirmation span {
  color: var(--color-teal);
  font-weight: 900;
}

.disclosure {
  margin: 24px auto 0;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.55;
  text-align: center;
}

.site-footer {
  width: min(1180px, calc(100% - 40px));
  margin: 10px auto 0;
  padding: 24px 0 28px;
  border-top: 1px solid var(--color-border);
  color: var(--color-muted);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  font-size: 0.72rem;
}

button:focus-visible,
textarea:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 3px solid rgba(166, 83, 32, 0.35);
  outline-offset: 3px;
}

@media (max-width: 900px) {
  .main-content {
    padding-top: 32px;
  }

  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .portfolio-card {
    order: 1;
  }

  .scenario-panel {
    order: 0;
  }
}

@media (max-width: 640px) {
  .site-header-inner {
    min-height: 56px;
  }

  .main-nav-inline {
    display: none;
  }

  /* Show mobile bottom nav */
  .mobile-nav {
    display: flex;
  }

  .demo-label,
  .coming-soon {
    display: none;
  }

  .main-content {
    width: min(100% - 28px, 1180px);
    padding-top: 28px;
  }

  .intro-section {
    margin-bottom: 24px;
  }

  .intro-section h1 {
    font-size: 1.6rem;
  }

  .scenario-panel,
  .portfolio-card {
    padding: 21px;
    border-radius: 14px;
  }

  .question-field-row {
    flex-direction: column;
  }

  .secondary-button {
    width: 100%;
  }

  .assumption-list {
    columns: 1;
  }

  .confirmed-scenario {
    flex-direction: column;
    gap: 4px;
  }

  .site-footer {
    width: min(100% - 28px, 1180px);
    flex-direction: column;
    gap: 6px;
  }

  .portfolio-edit-row {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .portfolio-page-header {
    flex-direction: column;
    gap: 12px;
  }

  .account-manager-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
.mock-mode-label {
  border: 1px solid #bddbd5;
  border-radius: 999px;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
  padding: 5px 9px;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.results-card {
  margin-top: 28px;
  padding: 34px;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  background: var(--color-white);
  box-shadow: 0 16px 45px rgba(17, 35, 48, 0.06);
  scroll-margin-top: 24px;
}

.results-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.results-header h2 {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(1.65rem, 3vw, 2.35rem);
  letter-spacing: -0.035em;
}

.results-header p:last-child {
  margin: 8px 0 0;
  color: var(--color-muted);
  font-size: 0.88rem;
}

.result-status {
  border: 1px solid #bddbd5;
  border-radius: 999px;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
  padding: 7px 11px;
  font-size: 0.72rem;
  font-weight: 800;
  white-space: nowrap;
}

.result-metrics {
  margin-top: 28px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.metric {
  min-height: 132px;
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: var(--color-surface);
}

.metric-emphasis {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
}

.metric span,
.metric strong,
.metric small {
  display: block;
}

.metric span {
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 700;
  line-height: 1.4;
}

.metric strong {
  margin-top: 12px;
  color: var(--color-navy);
  font-size: clamp(1.55rem, 3vw, 2.05rem);
  letter-spacing: -0.04em;
}

.metric small {
  margin-top: 8px;
  color: var(--color-muted);
  font-size: 0.78rem;
  font-weight: 750;
}

.number-negative {
  color: #8c3f38 !important;
}

.number-positive {
  color: var(--color-teal-dark) !important;
}

.inflation-notice {
  margin-top: 24px;
  border-left: 4px solid var(--color-teal);
  border-radius: 0 10px 10px 0;
  background: var(--color-teal-soft);
  padding: 14px 17px;
}

.inflation-notice strong,
.inflation-notice span {
  display: block;
}

.inflation-notice strong {
  font-size: 0.86rem;
}

.inflation-notice span {
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.78rem;
  line-height: 1.5;
}

.contribution-section {
  margin-top: 36px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border);
}

.result-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.result-section-heading h3,
.explanation-card h3 {
  margin: 0;
  color: var(--color-navy);
  font-size: 1.3rem;
  letter-spacing: -0.025em;
}

.zero-line-key {
  color: var(--color-muted);
  font-size: 0.7rem;
  font-weight: 700;
}

.contribution-chart {
  margin-top: 23px;
  display: grid;
  gap: 15px;
}

.contribution-row {
  display: grid;
  grid-template-columns: 130px minmax(160px, 1fr) 90px;
  align-items: center;
  gap: 14px;
}

.contribution-label strong,
.contribution-label span {
  display: block;
}

.contribution-label strong {
  font-size: 0.83rem;
}

.contribution-label span {
  margin-top: 3px;
  color: var(--color-muted);
  font-size: 0.7rem;
}

.contribution-row > strong {
  font-size: 0.79rem;
  text-align: right;
}

.contribution-track {
  position: relative;
  height: 24px;
  border-radius: 5px;
  background: #f2f1ec;
  overflow: hidden;
}

.chart-zero-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  z-index: 2;
  width: 2px;
  background: #68767c;
  transform: translateX(-1px);
}

.contribution-bar {
  position: absolute;
  top: 5px;
  bottom: 5px;
  min-width: 3px;
}

.contribution-bar-negative {
  border-radius: 4px 0 0 4px;
  background: #a95a50;
}

.contribution-bar-positive {
  border-radius: 0 4px 4px 0;
  background: var(--color-teal);
}

.zero-marker {
  position: absolute;
  top: 8px;
  left: 50%;
  z-index: 3;
  width: 8px;
  height: 8px;
  border: 2px solid #68767c;
  border-radius: 50%;
  background: var(--color-white);
  transform: translateX(-4px);
}

.table-scroll {
  margin-top: 28px;
  overflow-x: auto;
}

.holding-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.79rem;
}

.holding-table caption {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.holding-table th,
.holding-table td {
  padding: 13px 12px;
  border-bottom: 1px solid var(--color-border-soft);
  text-align: right;
  white-space: nowrap;
}

.holding-table thead th {
  color: var(--color-muted);
  font-size: 0.7rem;
  letter-spacing: 0.035em;
  text-transform: uppercase;
}

.holding-table th:first-child,
.holding-table td:first-child {
  padding-left: 0;
  text-align: left;
}

.holding-table th:last-child,
.holding-table td:last-child {
  padding-right: 0;
}

.holding-table tbody th strong,
.holding-table tbody th span {
  display: block;
}

.holding-table tbody th span {
  margin-top: 3px;
  color: var(--color-muted);
  font-size: 0.7rem;
  font-weight: 400;
}

.explanation-card {
  margin-top: 34px;
  padding: 24px;
  border-radius: 14px;
  background: #f3f6f4;
}

.explanation-card > p:not(.section-kicker) {
  max-width: 850px;
  margin: 13px 0 0;
  color: var(--color-muted);
  font-size: 0.9rem;
  line-height: 1.7;
}

.explanation-source {
  display: inline-block;
  margin-top: 16px;
  color: var(--color-muted);
  font-size: 0.69rem;
  font-weight: 700;
}

.assumptions-details {
  margin-top: 18px;
  border: 1px solid var(--color-border);
  border-radius: 11px;
  background: var(--color-white);
}

.assumptions-details summary {
  padding: 15px 17px;
  color: var(--color-navy);
  cursor: pointer;
  font-size: 0.82rem;
  font-weight: 800;
}

.assumptions-details summary:focus-visible {
  outline: 3px solid rgba(26, 121, 114, 0.28);
  outline-offset: 3px;
}

.assumptions-details > div {
  padding: 0 17px 17px;
  color: var(--color-muted);
  font-size: 0.79rem;
  line-height: 1.65;
}

.assumptions-details ul {
  margin: 10px 0;
  padding-left: 21px;
}

.assumptions-details li::marker {
  color: var(--color-teal);
}

.assumptions-version {
  margin-bottom: 0;
  font-size: 0.7rem;
}

.result-actions {
  margin-top: 24px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.advisor-preview-note {
  margin: 9px 0 0;
  color: var(--color-muted);
  font-size: 0.7rem;
  text-align: right;
}

.error-message {
  margin-top: 16px;
  border: 1px solid #e0b8b3;
  border-radius: 10px;
  background: #fff5f3;
  padding: 14px;
  color: #753730;
}

.error-message strong,
.error-message span {
  display: block;
}

.error-message strong {
  font-size: 0.82rem;
}

.error-message span {
  margin-top: 5px;
  font-size: 0.76rem;
  line-height: 1.5;
}

.error-message .text-button {
  margin-top: 7px;
  padding-left: 0;
  color: #753730;
}

@media (max-width: 760px) {
  .results-card {
    padding: 22px;
  }

  .results-header {
    flex-direction: column;
    gap: 12px;
  }

  .result-metrics {
    grid-template-columns: 1fr;
  }

  .metric {
    min-height: auto;
  }

  .contribution-row {
    grid-template-columns: 85px minmax(120px, 1fr) 76px;
    gap: 8px;
  }

  .result-actions {
    align-items: stretch;
    flex-direction: column-reverse;
  }

  .result-actions button {
    width: 100%;
  }

  .advisor-preview-note {
    text-align: center;
  }
}

@media (max-width: 500px) {
  .mock-mode-label {
    display: none;
  }

  .contribution-row {
    grid-template-columns: 62px minmax(100px, 1fr) 68px;
  }

  .contribution-label span {
    display: none;
  }

  .contribution-row > strong {
    font-size: 0.7rem;
  }

  .result-section-heading {
    flex-direction: column;
    gap: 5px;
  }
}

/* Loading state */
.loading-state {
  padding: 48px 0;
  color: var(--color-muted);
  font-size: 0.88rem;
  text-align: center;
}

/* Entrance animation */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.results-card-enter {
  animation: fadeSlideUp 0.35s ease both;
}

@media (prefers-reduced-motion: reduce) {
  .results-card-enter {
    animation: none;
  }
  .portfolio-card,
  .scenario-panel,
  .scenario-option {
    transition: none;
  }
}

/* Result summary banner */
.result-summary-banner {
  margin-top: 24px;
  padding: 20px 24px;
  border-radius: 14px;
  background: var(--color-navy);
  color: var(--color-white);
  display: flex;
  align-items: baseline;
  gap: 16px;
  flex-wrap: wrap;
}

.summary-label {
  font-size: 0.78rem;
  font-weight: 700;
  opacity: 0.75;
  white-space: nowrap;
}

.summary-number {
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--color-white) !important;
}

.summary-sub {
  font-size: 0.82rem;
  opacity: 0.8;
}

/* Key drivers section */
.drivers-section {
  margin-top: 28px;
  padding: 22px 24px;
  border-radius: 14px;
  background: #f3f6f4;
}

.drivers-heading {
  margin: 0 0 14px;
  color: var(--color-navy);
  font-size: 1.05rem;
  letter-spacing: -0.02em;
}

.drivers-list {
  margin: 0 0 14px;
  padding-left: 20px;
  color: var(--color-muted);
  font-size: 0.88rem;
  line-height: 1.7;
}

.drivers-list li::marker {
  color: var(--color-teal);
}

/* View switch active state */
.view-switch-active {
  border-color: var(--color-teal);
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
}

/* Interpret result banner */
.interpret-result {
  margin-top: 12px;
  padding: 14px 16px;
  border-radius: 10px;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  font-size: 0.82rem;
  line-height: 1.55;
}

.interpret-result p {
  margin: 0;
  color: var(--color-navy);
}

.interpret-result-matched {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
}

.interpret-result-preset_offered {
  border-color: #d4c4a0;
  background: #fdf8ee;
}

.interpret-result-unsupported {
  border-color: #e0b8b3;
  background: #fff5f3;
}

.mismatch-reasons {
  margin: 8px 0 0;
  padding-left: 18px;
  color: var(--color-muted);
  font-size: 0.78rem;
}

.interpret-confirm-note {
  margin: 8px 0 0 !important;
  color: var(--color-muted) !important;
  font-size: 0.76rem !important;
}

.offered-presets {
  margin-top: 10px;
  display: grid;
  gap: 6px;
}

.offered-presets > p {
  margin: 0 0 4px;
  color: var(--color-muted);
  font-size: 0.74rem;
  font-weight: 700;
}

/* Advisor success note */
.advisor-success-note {
  margin: 10px 0 0;
  color: var(--color-teal-dark);
  font-size: 0.76rem;
  font-weight: 700;
  text-align: right;
}

/* Advisor view */
.advisor-view {
  max-width: 860px;
}

.advisor-view-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.advisor-view-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.advisor-reset-btn {
  border-color: #e0b8b3 !important;
  color: #753730 !important;
}

.advisor-reset-btn:hover {
  background: #fff5f3 !important;
  border-color: #c0706a !important;
}

.advisor-reset-confirm {
  margin-bottom: 16px;
  padding: 16px 18px;
  border: 1px solid #e0b8b3;
  border-radius: 10px;
  background: #fff5f3;
  color: #753730;
  font-size: 0.86rem;
  line-height: 1.5;
}

.advisor-reset-confirm p {
  margin: 0 0 12px;
}

.advisor-reset-confirm-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.advisor-reset-confirm-btn {
  background: #8c3f38 !important;
  border-color: #8c3f38 !important;
}

.advisor-reset-confirm-btn:hover {
  background: #6e2e28 !important;
  border-color: #6e2e28 !important;
}

.advisor-reset-done {
  margin-bottom: 16px;
  padding: 12px 16px;
  border: 1px solid #bddbd5;
  border-radius: 10px;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
  font-size: 0.84rem;
  display: flex;
  align-items: center;
  gap: 12px;
}

.advisor-view-header h2 {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(1.65rem, 3vw, 2.35rem);
  letter-spacing: -0.035em;
}

.advisor-view-subtitle {
  margin: 8px 0 0;
  color: var(--color-muted);
  font-size: 0.86rem;
}

.advisor-demo-banner {
  margin-bottom: 24px;
  padding: 13px 16px;
  border: 1px solid #d4c4a0;
  border-radius: 10px;
  background: #fdf8ee;
  font-size: 0.79rem;
  line-height: 1.5;
  display: flex;
  gap: 10px;
  align-items: baseline;
}

.advisor-demo-banner strong {
  white-space: nowrap;
  color: #7a5c1e;
}

.advisor-demo-banner span {
  color: var(--color-muted);
}

.advisor-discussion-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 14px;
}

.advisor-discussion-card {
  padding: 22px;
  border: 1px solid var(--color-border);
  border-radius: 14px;
  background: var(--color-white);
}

.advisor-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.advisor-scenario-label {
  display: block;
  font-size: 1rem;
  color: var(--color-navy);
}

.advisor-client-name {
  display: block;
  margin-top: 3px;
  color: var(--color-muted);
  font-size: 0.76rem;
}

.advisor-status-badge {
  border-radius: 999px;
  padding: 4px 9px;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

.advisor-status-requested {
  border: 1px solid #bddbd5;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
}

.advisor-status-in_review {
  border: 1px solid #d4c4a0;
  background: #fdf8ee;
  color: #7a5c1e;
}

.advisor-status-closed {
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-muted);
}

.advisor-card-meta {
  margin-top: 10px;
  display: flex;
  gap: 18px;
  color: var(--color-muted);
  font-size: 0.74rem;
}

.advisor-source-question {
  margin: 10px 0 0;
  color: var(--color-muted);
  font-size: 0.79rem;
  line-height: 1.5;
}

.advisor-result-dl {
  margin: 14px 0 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.advisor-result-dl > div {
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: 9px;
  background: var(--color-surface);
}

.advisor-result-dl dt {
  color: var(--color-muted);
  font-size: 0.7rem;
  font-weight: 700;
}

.advisor-result-dl dd {
  margin: 5px 0 0;
  color: var(--color-navy);
  font-size: 0.88rem;
  font-weight: 800;
}

.advisor-assumptions {
  margin-top: 14px;
  border: 1px solid var(--color-border);
  border-radius: 9px;
}

.advisor-assumptions summary {
  padding: 10px 14px;
  font-size: 0.76rem;
  font-weight: 800;
  cursor: pointer;
  color: var(--color-navy);
}

.advisor-assumptions ul {
  margin: 0;
  padding: 0 14px 12px 28px;
  color: var(--color-muted);
  font-size: 0.74rem;
  line-height: 1.65;
}

.advisor-assumptions li::marker {
  color: var(--color-teal);
}

@media (max-width: 640px) {
  .advisor-result-dl {
    grid-template-columns: 1fr;
  }

  .advisor-card-meta {
    flex-direction: column;
    gap: 4px;
  }

  .advisor-view-header {
    flex-direction: column;
    gap: 12px;
  }
}

/* Six-card scenario grid */
.scenario-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

@media (max-width: 760px) {
  .scenario-options {
    grid-template-columns: 1fr;
  }
}

/* Advisor handoff panel */
.advisor-handoff-panel {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid #d4c4a0;
  border-radius: 10px;
  background: #fdf8ee;
}

.advisor-handoff-panel-inline {
  padding: 10px 14px;
  margin-top: 10px;
}

.advisor-handoff-heading {
  margin: 0 0 8px;
  color: var(--color-navy);
  font-size: 0.84rem;
  font-weight: 800;
}

.advisor-handoff-question {
  margin: 0 0 12px;
  color: var(--color-muted);
  font-size: 0.79rem;
  line-height: 1.5;
}

.advisor-note-label {
  display: block;
  margin-bottom: 6px;
  color: var(--color-navy);
  font-size: 0.79rem;
  font-weight: 700;
}

.advisor-note-input {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--color-border-strong);
  border-radius: 8px;
  background: var(--color-white);
  color: var(--color-navy);
  font: inherit;
  font-size: 0.84rem;
  resize: vertical;
  margin-bottom: 10px;
}

.advisor-q-success {
  margin: 8px 0 0;
  color: var(--color-teal-dark);
  font-size: 0.76rem;
  font-weight: 700;
}

.advisor-q-error {
  display: block;
  margin-top: 6px;
  color: #753730;
  font-size: 0.76rem;
}

/* Advisor card additions */
.advisor-card-header-right {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.advisor-type-badge {
  border-radius: 999px;
  padding: 4px 9px;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  border: 1px solid #d4c4a0;
  background: #fdf8ee;
  color: #7a5c1e;
  white-space: nowrap;
}

.advisor-unmodeled-body {
  margin-top: 12px;
}

.advisor-unmodeled-question {
  margin: 0 0 6px;
  color: var(--color-navy);
  font-size: 0.84rem;
  line-height: 1.5;
}

.advisor-unmodeled-note {
  margin: 0 0 6px;
  color: var(--color-muted);
  font-size: 0.79rem;
  line-height: 1.5;
}

.advisor-no-result {
  margin: 8px 0 0;
  padding: 8px 12px;
  border-radius: 7px;
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 700;
}

/* =========================================================
   PROFILE GATE
   ========================================================= */
.profile-gate {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--color-surface);
}

.profile-gate-card {
  width: min(480px, 100%);
  padding: 40px;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  background: var(--color-white);
  box-shadow: 0 24px 60px rgba(17, 35, 48, 0.1);
  animation: fadeSlideUp 0.3s ease both;
}

.profile-gate-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}

.profile-gate-title {
  margin: 0 0 6px;
  color: var(--color-navy);
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-align: center;
}

.profile-gate-tagline {
  margin: 0 0 24px;
  color: var(--color-teal-dark);
  font-size: 1rem;
  font-weight: 600;
  text-align: center;
}

.profile-gate-notice {
  margin-bottom: 24px;
  padding: 12px 14px;
  border: 1px solid #d4c4a0;
  border-radius: 9px;
  background: #fdf8ee;
  color: var(--color-muted);
  font-size: 0.78rem;
  line-height: 1.55;
}

.profile-gate-notice strong {
  color: #7a5c1e;
}

.profile-gate-section {
  margin-top: 20px;
}

.profile-gate-section-label {
  margin: 0 0 10px;
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.profile-list {
  margin: 0 0 12px;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 6px;
}

.profile-list-btn {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
  color: var(--color-navy);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  font: inherit;
  font-size: 0.88rem;
  font-weight: 600;
  transition: border-color 0.15s, background 0.15s;
}

.profile-list-btn:hover {
  border-color: var(--color-teal);
  background: var(--color-teal-soft);
}

.profile-list-btn-active {
  border-color: var(--color-teal);
  background: var(--color-teal-soft);
}

.profile-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-navy);
  color: var(--color-white);
  display: grid;
  place-items: center;
  font-size: 0.82rem;
  font-weight: 800;
  flex-shrink: 0;
}

.profile-avatar-sm {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--color-navy);
  color: var(--color-white);
  display: grid;
  place-items: center;
  font-size: 0.7rem;
  font-weight: 800;
  flex-shrink: 0;
}

.profile-active-mark {
  margin-left: auto;
  color: var(--color-teal-dark);
  font-weight: 900;
}

.profile-create-row {
  display: flex;
  gap: 8px;
}

.profile-name-input {
  flex: 1;
  min-height: 42px;
  padding: 9px 12px;
  border: 1px solid var(--color-border-strong);
  border-radius: 9px;
  background: var(--color-white);
  color: var(--color-navy);
  font: inherit;
  font-size: 0.88rem;
}

/* Profile bar (in header) */
.profile-bar {
  position: relative;
}

.profile-bar-btn {
  min-height: 36px;
  padding: 5px 10px;
  border: 1px solid var(--color-border-strong);
  border-radius: 9px;
  background: transparent;
  color: var(--color-navy);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 7px;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 700;
}

.profile-bar-caret {
  font-size: 0.6rem;
  opacity: 0.6;
}

.profile-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 100;
  min-width: 220px;
  padding: 14px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: var(--color-white);
  box-shadow: 0 12px 36px rgba(17, 35, 48, 0.14);
  animation: fadeSlideUp 0.15s ease both;
}

.profile-dropdown-label {
  margin: 0 0 8px;
  color: var(--color-muted);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.profile-list-sm {
  margin-bottom: 10px;
}

.profile-dropdown-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 8px;
  border-top: 1px solid var(--color-border-soft);
}

.text-button-danger {
  color: #8c3f38 !important;
}

/* =========================================================
   ACCOUNT BAR
   ========================================================= */
.account-bar {
  border-bottom: 1px solid var(--color-border);
  background: var(--color-white);
}

.account-bar-inner {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 8px 0;
}

.account-manager {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.account-manager-header {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.account-manager-label {
  color: var(--color-muted);
  font-size: 0.74rem;
  font-weight: 700;
  white-space: nowrap;
}

.account-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.account-tab {
  min-height: 32px;
  padding: 4px 12px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  font: inherit;
  font-size: 0.78rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: border-color 0.15s, background 0.15s, color 0.15s;
}

.account-tab:hover {
  border-color: var(--color-teal);
  color: var(--color-navy);
}

.account-tab-active {
  border-color: var(--color-navy);
  background: var(--color-navy);
  color: var(--color-white);
}

.account-tab-add {
  border-style: dashed;
  color: var(--color-teal-dark);
}

.account-rename-btn {
  border: none;
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  font-size: 0.72rem;
  padding: 0 2px;
  opacity: 0.7;
}

.account-rename-inline {
  display: flex;
  align-items: center;
  gap: 4px;
}

.account-rename-inline input {
  width: 100px;
  padding: 2px 6px;
  border: 1px solid var(--color-border-strong);
  border-radius: 5px;
  font: inherit;
  font-size: 0.78rem;
}

.account-create-inline {
  display: flex;
  align-items: center;
  gap: 4px;
}

.account-new-input {
  width: 120px;
  min-height: 30px;
  padding: 3px 8px;
  border: 1px solid var(--color-border-strong);
  border-radius: 7px;
  font: inherit;
  font-size: 0.78rem;
}

/* Mobile nav bar (shown only on narrow screens) */
.mobile-nav {
  display: none;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-white);
}

.mobile-nav-inner {
  width: min(1180px, calc(100% - 28px));
  margin: 0 auto;
  display: flex;
  gap: 0;
}

.mobile-nav .nav-tab {
  min-height: 44px;
  flex: 1;
  text-align: center;
}

/* =========================================================
   MAIN NAV TABS (inline in header)
   ========================================================= */
.main-nav {
  border-bottom: 1px solid var(--color-border);
  background: var(--color-white);
}

.main-nav-inner {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  display: flex;
  gap: 0;
}

.nav-tab {
  min-height: 64px;
  padding: 0 18px;
  border: none;
  border-bottom: 3px solid transparent;
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  font: inherit;
  font-size: 0.86rem;
  font-weight: 700;
  transition: color 0.15s, border-color 0.15s;
  white-space: nowrap;
}

.nav-tab:hover {
  color: var(--color-navy);
}

.nav-tab-active {
  color: var(--color-navy);
  border-bottom-color: var(--color-copper);
}

/* =========================================================
   PORTFOLIO PAGE
   ========================================================= */
.portfolio-page {
  max-width: 720px;
}

.portfolio-page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.portfolio-page-header h2 {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(1.65rem, 3vw, 2.35rem);
  letter-spacing: -0.035em;
}

.portfolio-page-sub {
  margin: 8px 0 0;
  color: var(--color-muted);
  font-size: 0.86rem;
  line-height: 1.55;
}

.portfolio-edit-notice {
  margin-bottom: 20px;
  padding: 12px 14px;
  border: 1px solid #d4c4a0;
  border-radius: 9px;
  background: #fdf8ee;
  color: var(--color-muted);
  font-size: 0.78rem;
  line-height: 1.5;
}

.portfolio-edit-notice strong {
  color: #7a5c1e;
}

.portfolio-edit-grid {
  display: grid;
  gap: 10px;
}

.portfolio-edit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(160px, 200px) 64px;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-white);
}

.portfolio-edit-row-error {
  border-color: #e0b8b3;
  background: #fff8f7;
}

.portfolio-edit-label strong,
.portfolio-edit-label span {
  display: block;
}

.portfolio-edit-label strong {
  font-size: 0.86rem;
}

.portfolio-edit-label span {
  margin-top: 2px;
  color: var(--color-muted);
  font-size: 0.72rem;
}

.portfolio-edit-input-wrap {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-border-strong);
  border-radius: 8px;
  overflow: hidden;
  background: var(--color-white);
}

.portfolio-edit-prefix {
  padding: 0 8px;
  color: var(--color-muted);
  font-size: 0.86rem;
  font-weight: 700;
  background: var(--color-surface);
  border-right: 1px solid var(--color-border-strong);
  align-self: stretch;
  display: flex;
  align-items: center;
}

.portfolio-edit-input {
  flex: 1;
  min-width: 0;
  min-height: 38px;
  padding: 6px 10px;
  border: none;
  background: transparent;
  color: var(--color-navy);
  font: inherit;
  font-size: 0.92rem;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.portfolio-edit-input:focus {
  outline: none;
}

.portfolio-edit-input-wrap:focus-within {
  outline: 3px solid rgba(166, 83, 32, 0.35);
  outline-offset: 1px;
}

.portfolio-edit-pct {
  color: var(--color-muted);
  font-size: 0.78rem;
  font-weight: 700;
  text-align: right;
}

.portfolio-edit-total {
  margin-top: 14px;
  padding: 14px 16px;
  border-radius: 10px;
  background: var(--color-navy);
  color: var(--color-white);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.portfolio-edit-total span {
  font-size: 0.82rem;
  opacity: 0.8;
}

.portfolio-edit-total strong {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.portfolio-edit-actions {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.portfolio-unsaved-banner {
  margin-bottom: 14px;
  padding: 10px 14px;
  border: 1px solid var(--color-copper-border);
  border-radius: 9px;
  background: var(--color-copper-soft);
  color: var(--color-copper);
  font-size: 0.82rem;
  line-height: 1.5;
}

.portfolio-unsaved-banner strong {
  color: #7a3a10;
}

.portfolio-field-error {
  grid-column: 1 / -1;
  margin: 0;
  color: #8c3f38;
  font-size: 0.74rem;
  line-height: 1.4;
}

.portfolio-saved-note {
  color: var(--color-teal-dark);
  font-size: 0.82rem;
  font-weight: 700;
}

.portfolio-page-note {
  margin-top: 16px;
  color: var(--color-muted);
  font-size: 0.74rem;
  line-height: 1.55;
}

.portfolio-edit-link {
  margin-top: 12px;
  padding-left: 0;
  font-size: 0.78rem;
}



/* =========================================================
   MAGNITUDE CONTROL
   ========================================================= */
.magnitude-control {
  margin: 18px 0 16px;
  padding: 16px 18px;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  background: var(--color-surface);
}

.magnitude-control-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.magnitude-label {
  color: var(--color-navy);
  font-size: 0.84rem;
  font-weight: 750;
}

.magnitude-reset {
  font-size: 0.72rem;
  color: var(--color-teal-dark);
  white-space: nowrap;
}

.magnitude-input-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.magnitude-slider {
  flex: 1;
  height: 6px;
  accent-color: var(--color-teal);
  cursor: pointer;
}

.magnitude-number-wrap {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-border-strong);
  border-radius: 8px;
  overflow: hidden;
  background: var(--color-white);
  flex-shrink: 0;
}

.magnitude-number-input {
  width: 64px;
  min-height: 36px;
  padding: 4px 8px;
  border: none;
  background: transparent;
  color: var(--color-navy);
  font: inherit;
  font-size: 0.88rem;
  font-weight: 700;
  text-align: right;
}

.magnitude-number-input:focus {
  outline: none;
}

.magnitude-number-wrap:focus-within {
  outline: 3px solid rgba(26, 121, 114, 0.28);
  outline-offset: 1px;
}

.magnitude-unit {
  padding: 0 8px;
  color: var(--color-muted);
  font-size: 0.78rem;
  font-weight: 700;
  background: var(--color-surface);
  border-left: 1px solid var(--color-border-strong);
  align-self: stretch;
  display: flex;
  align-items: center;
}

.magnitude-range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.68rem;
}

.magnitude-pp-note {
  margin: 10px 0 0;
  padding: 8px 10px;
  border-left: 3px solid var(--color-teal);
  background: var(--color-teal-soft);
  color: var(--color-navy);
  font-size: 0.76rem;
  line-height: 1.5;
}

.magnitude-methodology {
  margin-top: 10px;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-white);
}

.magnitude-methodology summary {
  padding: 8px 12px;
  color: var(--color-muted);
  font-size: 0.74rem;
  font-weight: 700;
  cursor: pointer;
}

.magnitude-methodology p {
  margin: 0;
  padding: 0 12px 10px;
  color: var(--color-muted);
  font-size: 0.74rem;
  line-height: 1.55;
}

/* =========================================================
   HORIZON CONTROL
   ========================================================= */
.horizon-control {
  margin: 12px 0 16px;
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-teal-soft);
}

.horizon-disabled-note {
  margin: 12px 0 16px;
  padding: 10px 14px;
  border-left: 3px solid var(--color-border-strong);
  border-radius: 0 8px 8px 0;
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 0.78rem;
  line-height: 1.55;
}

.horizon-disabled-note strong {
  color: var(--color-navy);
}

/* =========================================================
   STALE RESULT BANNER
   ========================================================= */
.stale-result-banner {
  margin-top: 20px;
  padding: 12px 16px;
  border: 1px solid #d4c4a0;
  border-radius: 10px;
  background: #fdf8ee;
  color: #7a5c1e;
  font-size: 0.82rem;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.stale-result-banner strong {
  color: #5a3e0e;
}

.stale-result-banner .text-button {
  color: #7a5c1e;
  margin-left: auto;
}

/* =========================================================
   ADVISOR MODE LABEL
   ========================================================= */
.advisor-mode-label {
  border: 1px solid #a9cbc5;
  border-radius: 999px;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
  padding: 5px 10px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* =========================================================
   PROFILE DROPDOWN ADVISOR SWITCH
   ========================================================= */
.profile-dropdown-advisor {
  padding-top: 8px;
  border-top: 1px solid var(--color-border-soft);
  margin-top: 8px;
}

.profile-advisor-switch-btn {
  width: 100%;
  text-align: left;
  padding: 6px 2px;
  font-size: 0.8rem;
  color: var(--color-teal-dark) !important;
}

/* =========================================================
   UNSAVED GUARD OVERLAY
   ========================================================= */
.unsaved-guard-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(10, 20, 30, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.unsaved-guard-card {
  width: min(440px, 100%);
  padding: 32px;
  border-radius: 18px;
  background: var(--color-white);
  box-shadow: 0 24px 60px rgba(17, 35, 48, 0.2);
  animation: fadeSlideUp 0.2s ease both;
}

.unsaved-guard-title {
  margin: 0 0 10px;
  color: var(--color-navy);
  font-size: 1.3rem;
  letter-spacing: -0.025em;
}

.unsaved-guard-body {
  margin: 0 0 20px;
  color: var(--color-muted);
  font-size: 0.88rem;
  line-height: 1.6;
}

.unsaved-guard-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

/* =========================================================
   HORIZON PRESET BUTTONS
   ========================================================= */
.horizon-preset-buttons {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.horizon-preset-btn {
  min-height: 34px;
  padding: 4px 14px;
  border: 1px solid var(--color-border-strong);
  border-radius: 999px;
  background: var(--color-white);
  color: var(--color-navy);
  cursor: pointer;
  font: inherit;
  font-size: 0.8rem;
  font-weight: 700;
  transition: border-color 0.15s, background 0.15s;
}

.horizon-preset-btn:hover {
  border-color: var(--color-teal);
  background: var(--color-teal-soft);
}

.horizon-preset-btn-active {
  border-color: var(--color-teal);
  background: var(--color-teal);
  color: var(--color-white);
}

/* =========================================================
   MAGNITUDE CUSTOMIZED NOTE & CONFIG ERROR
   ========================================================= */
.magnitude-customized-note {
  margin: 10px 0 0;
  padding: 8px 12px;
  border-left: 3px solid #d4c4a0;
  background: #fdf8ee;
  color: #7a5c1e;
  font-size: 0.76rem;
  line-height: 1.5;
}

.magnitude-config-error {
  margin: 14px 0;
  padding: 14px 16px;
  border: 1px solid #e0b8b3;
  border-radius: 10px;
  background: #fff5f3;
  color: #753730;
}

.magnitude-config-error strong,
.magnitude-config-error span {
  display: block;
}

.magnitude-config-error strong {
  font-size: 0.84rem;
  margin-bottom: 4px;
}

.magnitude-config-error span {
  font-size: 0.78rem;
  line-height: 1.5;
}

/* =========================================================
   PORTFOLIO EXPLORE CTA
   ========================================================= */
.portfolio-explore-cta {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--color-border);
}

.portfolio-explore-hint {
  margin: 8px 0 0;
  color: var(--color-muted);
  font-size: 0.78rem;
}

.portfolio-card-actions {
  margin-top: 12px;
}

/* =========================================================
   TIMELINE CARDS
   ========================================================= */
.timeline-section {
  margin-top: 36px;
  padding-top: 32px;
  border-top: 1px solid var(--color-border);
}

.timeline-heading {
  margin: 0 0 20px;
  color: var(--color-navy);
  font-size: 1.2rem;
  letter-spacing: -0.02em;
}

.timeline-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.timeline-card {
  padding: 20px;
  border-radius: 14px;
  border: 1px solid var(--color-border);
  background: var(--color-white);
}

.timeline-card-adverse {
  border-color: #e0b8b3;
  background: #fff8f7;
}

.timeline-card-mixed {
  border-color: #d4c4a0;
  background: #fdf8ee;
}

.timeline-card-favorable {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
}

.timeline-card-neutral {
  border-color: var(--color-border);
  background: var(--color-surface);
}

.timeline-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.timeline-card-label {
  display: block;
  color: var(--color-navy);
  font-size: 0.9rem;
  font-weight: 800;
}

.timeline-card-timeframe {
  display: block;
  margin-top: 2px;
  color: var(--color-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.timeline-assessment-badge {
  border-radius: 999px;
  padding: 4px 9px;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  white-space: nowrap;
  flex-shrink: 0;
}

.timeline-assessment-adverse {
  border: 1px solid #e0b8b3;
  background: #fff0ee;
  color: #8c3f38;
}

.timeline-assessment-mixed {
  border: 1px solid #d4c4a0;
  background: #fdf8ee;
  /* Dark amber text on pale yellow for contrast */
  color: #6b4c10;
}

.timeline-assessment-favorable {
  border: 1px solid #a9cbc5;
  background: var(--color-teal-soft);
  color: var(--color-teal-dark);
}

.timeline-assessment-neutral {
  border: 1px solid var(--color-border-strong);
  background: var(--color-surface);
  color: var(--color-muted);
}

.timeline-card-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 14px;
}

.timeline-card-value {
  padding: 10px 12px;
  border-radius: 9px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(0,0,0,0.06);
}

.timeline-value-label {
  display: block;
  color: var(--color-muted);
  font-size: 0.68rem;
  font-weight: 700;
  line-height: 1.3;
}

.timeline-value-number {
  display: block;
  margin-top: 4px;
  color: var(--color-navy);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.timeline-value-sub {
  display: block;
  margin-top: 2px;
  color: var(--color-muted);
  font-size: 0.7rem;
}

.timeline-qualitative-label {
  margin: 0 0 10px;
  padding: 6px 10px;
  border-radius: 6px;
  background: rgba(0,0,0,0.04);
  color: var(--color-muted);
  font-size: 0.7rem;
  font-weight: 700;
  font-style: italic;
}

.timeline-card-explanation {
  margin: 0 0 10px;
  color: var(--color-muted);
  font-size: 0.8rem;
  line-height: 1.6;
}

.timeline-card-drivers {
  margin: 0;
  padding-left: 16px;
  color: var(--color-muted);
  font-size: 0.76rem;
  line-height: 1.6;
}

.timeline-card-drivers li::marker {
  color: var(--color-teal);
}

.timeline-disclosure {
  margin: 14px 0 0;
  color: var(--color-muted);
  font-size: 0.72rem;
  line-height: 1.5;
  font-style: italic;
}

@media (max-width: 900px) {
  .timeline-cards-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .timeline-cards-grid {
    grid-template-columns: 1fr;
  }

  .timeline-card-values {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   SCENARIO COMPARISON
   ========================================================= */
.cmp-panel {
  margin-top: 28px;
  padding: 34px;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  background: var(--color-white);
  box-shadow: 0 16px 45px rgba(17, 35, 48, 0.06);
  scroll-margin-top: 24px;
  animation: fadeSlideUp 0.35s ease both;
}

.cmp-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.cmp-header h2 {
  margin: 0;
  color: var(--color-navy);
  font-size: clamp(1.5rem, 3vw, 2.1rem);
  letter-spacing: -0.03em;
}

.cmp-subtitle {
  margin: 8px 0 0;
  color: var(--color-muted);
  font-size: 0.86rem;
  line-height: 1.55;
}

.cmp-config-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.cmp-side-config {
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: 14px;
  background: var(--color-surface);
}

.cmp-side-label {
  margin: 0 0 14px;
  color: var(--color-copper);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.cmp-scenario-select-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-bottom: 4px;
}

.cmp-scenario-btn {
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-white);
  color: var(--color-navy);
  cursor: pointer;
  text-align: left;
  font: inherit;
  transition: border-color 0.15s, background 0.15s;
}

.cmp-scenario-btn:hover {
  border-color: #86aaa6;
  background: #fbfcfa;
}

.cmp-scenario-btn-active {
  border-color: var(--color-teal);
  background: var(--color-teal-soft);
  box-shadow: inset 0 0 0 1px var(--color-teal);
}

.cmp-scenario-btn strong {
  display: block;
  font-size: 0.82rem;
}

.cmp-scenario-btn span {
  display: block;
  margin-top: 3px;
  color: var(--color-muted);
  font-size: 0.68rem;
}

.cmp-horizon-row {
  margin-top: 12px;
}

.cmp-run-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
}

.cmp-run-hint {
  color: var(--color-muted);
  font-size: 0.8rem;
}

.cmp-results-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 20px;
}

.cmp-result-col {
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: 14px;
  background: var(--color-white);
}

.cmp-result-col-label {
  margin: 0 0 14px;
  color: var(--color-copper);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.cmp-result-loading {
  padding: 24px 0;
  color: var(--color-muted);
  font-size: 0.86rem;
  text-align: center;
}

.cmp-result-error {
  padding: 12px 14px;
  border: 1px solid #e0b8b3;
  border-radius: 9px;
  background: #fff5f3;
  color: #753730;
  font-size: 0.82rem;
  line-height: 1.5;
}

.cmp-result-empty {
  padding: 24px 0;
  color: var(--color-muted);
  font-size: 0.82rem;
  text-align: center;
  font-style: italic;
}

.cmp-pp-notice {
  margin: 0 0 12px;
  padding: 8px 10px;
  border-left: 3px solid var(--color-teal);
  background: var(--color-teal-soft);
  color: var(--color-navy);
  font-size: 0.74rem;
  line-height: 1.5;
}

.cmp-metric {
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-surface);
  margin-bottom: 8px;
}

.cmp-metric span,
.cmp-metric strong,
.cmp-metric small {
  display: block;
}

.cmp-metric span {
  color: var(--color-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.cmp-metric strong {
  margin-top: 6px;
  color: var(--color-navy);
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.cmp-metric small {
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.76rem;
  font-weight: 700;
}

.cmp-metric-emphasis {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
}

.cmp-metric-negative {
  border-color: #e0b8b3;
  background: #fff8f7;
}

.cmp-metric-positive {
  border-color: #a9cbc5;
  background: var(--color-teal-soft);
}

.cmp-result-note {
  margin: 6px 0 8px;
  color: var(--color-muted);
  font-size: 0.74rem;
}

.cmp-holdings-detail {
  margin-top: 10px;
  border: 1px solid var(--color-border);
  border-radius: 9px;
}

.cmp-holdings-detail summary {
  padding: 8px 12px;
  font-size: 0.76rem;
  font-weight: 800;
  cursor: pointer;
  color: var(--color-navy);
}

.cmp-holdings-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.74rem;
  padding: 0 12px 10px;
}

.cmp-holdings-table th,
.cmp-holdings-table td {
  padding: 6px 12px;
  text-align: right;
  border-bottom: 1px solid var(--color-border-soft);
}

.cmp-holdings-table th:first-child,
.cmp-holdings-table td:first-child {
  text-align: left;
}

.cmp-holdings-table thead th {
  color: var(--color-muted);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.cmp-diff-row {
  margin-top: 20px;
  padding: 20px 22px;
  border: 1px solid var(--color-border);
  border-radius: 14px;
  background: var(--color-surface);
}

.cmp-diff-incompatible {
  border-color: #d4c4a0;
  background: #fdf8ee;
}

.cmp-diff-incompatible strong {
  display: block;
  margin-bottom: 6px;
  color: #7a5c1e;
  font-size: 0.86rem;
}

.cmp-diff-incompatible span {
  color: var(--color-muted);
  font-size: 0.8rem;
  line-height: 1.55;
}

.cmp-diff-heading {
  margin: 0 0 14px;
  color: var(--color-navy);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.cmp-diff-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}

.cmp-diff-metric {
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--color-white);
}

.cmp-diff-metric span,
.cmp-diff-metric strong,
.cmp-diff-metric small {
  display: block;
}

.cmp-diff-metric span {
  color: var(--color-muted);
  font-size: 0.72rem;
  font-weight: 700;
}

.cmp-diff-metric strong {
  margin-top: 6px;
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.cmp-diff-metric small {
  margin-top: 4px;
  color: var(--color-muted);
  font-size: 0.72rem;
}

.cmp-diff-note {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.74rem;
  line-height: 1.55;
  font-style: italic;
}

/* Responsive */
@media (max-width: 900px) {
  .cmp-config-grid,
  .cmp-results-grid {
    grid-template-columns: 1fr;
  }

  .cmp-diff-metrics {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .cmp-panel {
    padding: 22px;
  }

  .cmp-header {
    flex-direction: column;
    gap: 12px;
  }

  .cmp-scenario-select-grid {
    grid-template-columns: 1fr;
  }

  .cmp-run-row {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* =========================================================
   AUTH GATE
   ========================================================= */
.auth-gate {
