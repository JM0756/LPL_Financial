<file path="src/api.ts">
import { analysisFixtures, portfolioFixture } from "./mocks/fixtures";
import type { AnalysisResult, Portfolio, ScenarioKey } from "./types";

export type ApiMode = "mock" | "real";

export const API_MODE: ApiMode =
  import.meta.env.VITE_API_MODE === "real" ? "real" : "mock";

const API_BASE_URL = import.meta.env.VITE_API_BASE_URL ?? "";

function wait(milliseconds: number, signal?: AbortSignal): Promise<void> {
  return new Promise((resolve, reject) => {
    const timeoutId = window.setTimeout(resolve, milliseconds);

    signal?.addEventListener(
      "abort",
      () => {
        window.clearTimeout(timeoutId);
        reject(new DOMException("Request was cancelled.", "AbortError"));
      },
      { once: true },
    );
  });
}

async function parseResponse<T>(response: Response): Promise<T> {
  if (!response.ok) {
    let message = `Request failed with status ${response.status}.`;

    try {
      const body = (await response.json()) as {
        detail?: string;
        message?: string;
      };

      message = body.detail ?? body.message ?? message;
    } catch {
      // Keep the status-based message when the body is not JSON.
    }

    throw new Error(message);
  }

  return (await response.json()) as T;
}

export async function getPortfolio(
  signal?: AbortSignal,
): Promise<Portfolio> {
  if (API_MODE === "mock") {
    await wait(250, signal);
    return structuredClone(portfolioFixture);
  }

  const response = await fetch(`${API_BASE_URL}/api/portfolio`, {
    method: "GET",
    headers: {
      Accept: "application/json",
    },
    signal,
  });

  return parseResponse<Portfolio>(response);
}

export async function analyzeScenario(
  scenarioKey: ScenarioKey,
  signal?: AbortSignal,
): Promise<AnalysisResult> {
  if (API_MODE === "mock") {
    await wait(650, signal);
    return structuredClone(analysisFixtures[scenarioKey]);
  }

  // This request body is provisional because no API contract was found.
  const response = await fetch(`${API_BASE_URL}/api/analyze`, {
    method: "POST",
    headers: {
      Accept: "application/json",
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      scenario_key: scenarioKey,
    }),
    signal,
  });

  return parseResponse<AnalysisResult>(response);
}
