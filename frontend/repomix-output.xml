export type ScenarioKey =
  | "market_crash"
  | "oil_shock"
  | "inflation";

export type ScenarioKind = "market" | "purchasing-power";

export interface PortfolioHolding {
  symbol: string;
  name: string;
  value: number;
  allocation: number;
}

export interface Portfolio {
  id: string;
  name: string;
  totalValue: number;
  holdings: PortfolioHolding[];
}

export interface ScenarioDefinition {
  key: ScenarioKey;
  label: string;
  shortDescription: string;
  horizon: string;
  assumptions: string[];
  kind: ScenarioKind;
}

export interface HoldingAnalysis {
  symbol: string;
  name: string;
  startingValue: number;
  assumedReturnPercent: number;
  contributionDollars: number;
}

export interface AnalysisResult {
  analysisId: string;
  scenarioKey: ScenarioKey;
  kind: ScenarioKind;
  label: string;
  horizon: string;
  assumptionsVersion: string;
  explanation: string;
  explanationSource: "predefined" | "bedrock" | "backend-standard";

  currentValue?: number;
  scenarioValue?: number;
  impactDollars?: number;
  impactPercent?: number;
  holdings?: HoldingAnalysis[];

  nominalValue?: number;
  nominalReturnPercent?: number;
  purchasingPowerValue?: number;
  purchasingPowerChangeDollars?: number;
  purchasingPowerChangePercent?: number;
}
