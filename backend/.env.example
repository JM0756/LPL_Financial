# ---- AWS ----
AWS_REGION=us-east-1

# ---- Bedrock ----
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_TIMEOUT_SECONDS=6
BEDROCK_CONNECT_TIMEOUT_SECONDS=2
BEDROCK_MAX_TOKENS=400
# Reject LLM explanations that contain digits/$/% (backend owns all displayed numbers)
BEDROCK_REJECT_NUMERIC_OUTPUT=true

# ---- DynamoDB ----
STORAGE_ENABLED=true
DYNAMODB_TABLE=scenariocraft-mvp
# Set for DynamoDB Local, leave blank for real AWS
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ---- API ----
ALLOWED_ORIGINS=https://dh133zzs2y30r.cloudfront.net,http://localhost:5176

# ---- Cognito Authentication (optional) ----
# Set AUTH_ENABLED=true to require JWT validation on protected endpoints.
# When false (default), the API runs in demo mode with a synthetic identity.
AUTH_ENABLED=false
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_PhjZfR6YT
# COGNITO_CLIENT_ID=49qhbnk67bon3fc3g5rad8he1a